root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{bash,css,js,json,lock,md,nix,pl,pm,py,rb,sh,ts,xml}]
indent_style = space

[*.{js,json,lock,md,nix,rb,ts,bash,sh}]
indent_size = 2

[*.{diff,patch}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.json]
insert_final_newline = unset

[*.lock]
indent_size = unset
